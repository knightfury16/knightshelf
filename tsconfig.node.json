{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /**
   * Anything that runs in node rather than the browser. The `*.node.test.ts` suffix marks
   * a test that touches node APIs — reading a source file off disk, say — and keeps node's
   * globals out of tsconfig.app.json, where `process.env` has no business typechecking.
   */
  "include": ["vite.config.ts", "vitest.config.ts", "src/**/*.node.test.ts"]
}
